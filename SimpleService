from fastapi import FastAPI
from TestConstants import TestConstants

app = FastAPI()

def get_masked_constants():
    """Get constants with sensitive values masked"""
    return {
        name: "*****" if any(s in name.lower() for s in {"key", "secret", "token"}) else value
        for name, value in vars(TestConstants).items()
        if name.isupper() and not name.startswith('__')
    }

@app.get("/", response_model=dict)
async def read_root():
    return {
        "status": "Running with configured constants",
        "constants": get_masked_constants()
    }

# Test the constants output
if __name__ == "__main__":
    print("Test output:", get_masked_constants())
