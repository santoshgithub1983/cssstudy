from fastapi import APIRouter, UploadFile, File
from app.services.gitlab_service import create_gitlab_issue
from app.models.gitlab import GitLabIssueRequest

router = APIRouter()

@router.post("/create-issue")
async def create_issue(request: GitLabIssueRequest, files: list[UploadFile] = File(...)):
    # Convert UploadFile to file-like objects
    file_objects = [file.file for file in files]
    issue = create_gitlab_issue(request.title, request.description, file_objects)
    return {"issue": issue}
