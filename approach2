Step 7: Create API Endpoints
Create app/routers/chat.py:

python
Copy
from fastapi import APIRouter
from app.services.openai_service import process_prompt
from app.utils.rag import search_documents
from app.models.chat import ChatRequest

router = APIRouter()

@router.post("/chat")
async def chat(request: ChatRequest):
    if "create issue" in request.prompt.lower() or "create incident" in request.prompt.lower() or "create ticket" in request.prompt.lower():
        return {"message": "Please use the /create-issue endpoint to create a GitLab issue."}
    else:
        # Use RAG to search documents
        rag_results = search_documents(request.prompt)
        # Process the prompt with OpenAI
        response = process_prompt(f"{request.prompt}\n\nRelevant documents: {rag_results}")
        return {"response": response, "rag_results": rag_results}
