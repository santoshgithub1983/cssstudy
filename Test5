import cv2
import numpy as np
import winsound  # For Windows; use `os.system('beep')` for Linux/Mac

# Initialize HOG descriptor for person detection
hog = cv2.HOGDescriptor()
hog.setSVMDetector(cv2.HOGDescriptor_getDefaultPeopleDetector())

def detect_slouching(frame):
    # Detect people in the frame
    (rects, _) = hog.detectMultiScale(frame, winStride=(4, 4), padding=(8, 8), scale=1.05)

    slouching_detected = False

    for (x, y, w, h) in rects:
        # Draw bounding box
        cv2.rectangle(frame, (x, y), (x + w, y + h), (0, 255, 0), 2)

        # Check for slouching
        aspect_ratio = h / w
        if aspect_ratio > 2.5:  # Adjust threshold based on testing
            slouching_detected = True
            # Draw slouching alert text
            cv2.putText(frame, "Slouching Detected!", (x, y - 10),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 0, 255), 2)  # Red text

    return slouching_detected

def play_alert():
    """Play a beep sound for slouching alert."""
    winsound.Beep(1000, 500)  # Frequency: 1000Hz, Duration: 500ms

def main():
    cap = cv2.VideoCapture(0)
    if not cap.isOpened():
        print("Error: Could not open camera.")
        return

    while True:
        ret, frame = cap.read()
        if not ret:
            print("Error: Could not read frame.")
            break

        # Detect slouching
        slouching = detect_slouching(frame)

        # Play alert if slouching is detected
        if slouching:
            play_alert()

        # Show the frame
        cv2.imshow("Slouching Detection", frame)

        # Exit on 'q' key press
        if cv2.waitKey(1) & 0xFF == ord('q'):
            break

    cap.release()
    cv2.destroyAllWindows()

if __name__ == '__main__':
    main()
