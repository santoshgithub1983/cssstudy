6. Add the /create-issue Endpoint
Create a new route to handle issue creation.

gitlab_issues.py
python
Copy
from fastapi import APIRouter, UploadFile, File, Depends, HTTPException
from app.models.gitlab_models import CreateIssueRequest
from app.services.gitlab_service import GitLabService
from app.utils.file_utils import save_uploaded_file

router = APIRouter()

@router.post("/create-issue")
async def create_issue(
    request: CreateIssueRequest,
    files: List[UploadFile] = File(None),
    gitlab_service: GitLabService = Depends(GitLabService),
):
    try:
        # Save uploaded files
        file_paths = []
        if files:
            for file in files:
                file_path = save_uploaded_file(file)
                file_paths.append(file_path)

        # Create the issue
        issue = gitlab_service.create_issue(
            title=request.title,
            description=f"""
                **Description**: {request.description}
                **Employee ID**: {request.employee_id}
                **Email**: {request.email}
                **Name**: {request.name}
            """,
            files=file_paths,
        )

        # Return the issue details
        return {
            "issue_id": issue["id"],
            "issue_url": issue["web_url"],
            "message": "Issue created successfully!",
        }
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))
