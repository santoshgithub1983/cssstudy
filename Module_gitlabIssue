4. Implement the GitLab Service
Create a new service to interact with the GitLab API.

gitlab_service.py
python
Copy
import requests
import os
from typing import Optional, List

class GitLabService:
    def __init__(self):
        self.gitlab_url = os.getenv("GITLAB_URL", "https://gitlab.com")
        self.gitlab_token = os.getenv("GITLAB_TOKEN")
        self.project_id = os.getenv("GITLAB_PROJECT_ID")

    def create_issue(
        self,
        title: str,
        description: str,
        assignee_ids: Optional[List[int]] = None,
        labels: Optional[List[str]] = None,
        files: Optional[List[str]] = None,
    ) -> dict:
        """
        Create a GitLab issue with optional file attachments.
        """
        issue_url = f"{self.gitlab_url}/api/v4/projects/{self.project_id}/issues"
        headers = {
            "PRIVATE-TOKEN": self.gitlab_token,
        }
        data = {
            "title": title,
            "description": description,
            "assignee_ids": assignee_ids or [],
            "labels": labels or [],
        }

        # Create the issue
        response = requests.post(issue_url, headers=headers, json=data)
        response.raise_for_status()
        issue = response.json()

        # Attach files if provided
        if files:
            for file_path in files:
                self.attach_file_to_issue(issue["id"], file_path)

        return issue

    def attach_file_to_issue(self, issue_id: int, file_path: str) -> None:
        """
        Attach a file to a GitLab issue.
        """
        upload_url = f"{self.gitlab_url}/api/v4/projects/{self.project_id}/uploads"
        headers = {
            "PRIVATE-TOKEN": self.gitlab_token,
        }
        with open(file_path, "rb") as file:
            files = {"file": file}
            response = requests.post(upload_url, headers=headers, files=files)
            response.raise_for_status()
            upload = response.json()

            # Add the uploaded file to the issue description
            issue_url = f"{self.gitlab_url}/api/v4/projects/{self.project_id}/issues/{issue_id}"
            data = {
                "description": f"{upload['markdown']}\n\n",  # Append the file link
            }
            response = requests.put(issue_url, headers=headers, json=data)
            response.raise_for_status()
