import os
import json
from langchain.vectorstores import FAISS
from langchain.embeddings import AzureOpenAIEmbeddings

def save_vector_store(vector_store, folder_path: str):
    """
    Save the FAISS vector store and metadata to the specified folder.
    """
    # Ensure the directory exists
    os.makedirs(folder_path, exist_ok=True)

    # Save the FAISS index
    vector_store.save_local(folder_path)

    # Save metadata separately (e.g., document IDs, embeddings)
    metadata = {
        "documents": vector_store.docstore._dict,
        "index_to_docstore_id": vector_store.index_to_docstore_id,
    }
    with open(os.path.join(folder_path, "metadata.json"), "w") as f:
        json.dump(metadata, f)

def load_vector_store(folder_path: str, embeddings):
    """
    Load the FAISS vector store and metadata from the specified folder.
    """
    # Ensure the directory exists
    if not os.path.exists(folder_path):
        raise FileNotFoundError(f"Vector store directory not found: {folder_path}")

    # Load the FAISS index
    vector_store = FAISS.load_local(folder_path, embeddings, allow_dangerous_deserialization=False)

    # Load metadata separately
    metadata_path = os.path.join(folder_path, "metadata.json")
    if os.path.exists(metadata_path):
        with open(metadata_path, "r") as f:
            metadata = json.load(f)

        # Restore metadata
        vector_store.docstore._dict = metadata["documents"]
        vector_store.index_to_docstore_id = metadata["index_to_docstore_id"]

    return vector_store
