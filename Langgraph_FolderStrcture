# app/agents/research.py
from typing import Callable
from langchain_core.language_models import BaseLanguageModel
from app.core.context import AppContext

def research_node(context: AppContext) -> Callable:
    async def _research_node(state: dict):
        # Access LLM from context
        result = await context.llm.ainvoke(
            f"Research query: {state['query']}"
        )
        
        # Access other resources
        search_results = context.search_client.query(
            state['query'], 
            api_key=context.config.search_api_key
        )
        
        return {**state, "research_data": result.content}
    
    return _research_node
