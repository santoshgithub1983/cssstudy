# app/core/workflow.py
from langgraph.graph import StateGraph
from app.agents import research, writer
from app.tools import web_search

def create_workflow(config):
    workflow = StateGraph(research.ResearchState)
    
    # Add nodes
    workflow.add_node("research", research.execute)
    workflow.add_node("write", writer.execute)
    workflow.add_node("validate", web_search.validate_sources)
    
    # Define edges
    workflow.add_edge("research", "validate")
    workflow.add_conditional_edges(
        "validate",
        lambda x: "write" if x["valid_sources"] else "research",
    )
    workflow.add_edge("write", END)
    
    return workflow.compile()
