# app/agents/research.py
from langgraph.prebuilt import ToolNode
from app.tools import web_search

class ResearchState(BaseModel):
    query: str
    sources: list[str] = []
    content: str = ""

async def execute(state: ResearchState):
    search_results = await web_search.search(state.query)
    return {**state.dict(), "sources": search_results}
