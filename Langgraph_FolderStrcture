Alternative Approach: Class-based Nodes

python
Copy
# app/agents/base.py
from abc import ABC, abstractmethod
from app.core.context import AppContext

class BaseNode(ABC):
    def __init__(self, context: AppContext):
        self.llm = context.llm
        self.config = context.config
    
    @abstractmethod
    async def execute(self, state: dict) -> dict:
        pass

# app/agents/research.py
from app.agents.base import BaseNode

class ResearchNode(BaseNode):
    async def execute(self, state: dict) -> dict:
        prompt = self._create_prompt(state["query"])
        result = await self.llm.ainvoke(prompt)
        return {**state, "research": result.content}
    
    def _create_prompt(self, query: str) -> str:
        return f"""Research this query: {query}
        Current date: {self.config.current_date}
        Max sources: {self.config.max_sources}"""
