from fastapi import UploadFile, HTTPException
import httpx
from app.core.config import settings

class GitLabService:
    def __init__(self):
        self.base_url = settings.gitlab_url
        self.headers = {"PRIVATE-TOKEN": settings.gitlab_token}

    async def upload_file(self, file: UploadFile):
        """
        Uploads a file to GitLab and returns the markdown link for the uploaded file.
        """
        try:
            # Read the file content
            file_content = await file.read()
            
            # Upload the file to GitLab
            async with httpx.AsyncClient() as client:
                response = await client.post(
                    f"{self.base_url}/uploads",
                    files={"file": (file.filename, file_content)},
                    headers=self.headers
                )
            
            # Check for errors
            if response.status_code != 201:
                raise HTTPException(
                    status_code=response.status_code,
                    detail=f"Failed to upload file to GitLab: {response.text}"
                )
            
            # Return the markdown link for the uploaded file
            return response.json()["markdown"]
        
        except Exception as e:
            raise HTTPException(
                status_code=500,
                detail=f"An error occurred while uploading the file: {str(e)}"
            )

    async def create_issue(self, username: str, description: str, 
                          screenshot: UploadFile = None, logs: UploadFile = None):
        """
        Creates a GitLab issue with the provided description and optional attachments.
        """
        attachments = []
        
        # Upload screenshot if provided
        if screenshot:
            screenshot_markdown = await self.upload_file(screenshot)
            attachments.append(screenshot_markdown)
        
        # Upload logs if provided
        if logs:
            logs_markdown = await self.upload_file(logs)
            attachments.append(logs_markdown)
        
        # Prepare issue data
        issue_data = {
            "title": f"Issue from {username}",
            "description": f"{description}\n\nAttachments:\n" + "\n".join(attachments)
        }
        
        # Create the issue in GitLab
        async with httpx.AsyncClient() as client:
            response = await client.post(
                f"{self.base_url}/projects/{settings.gitlab_project_id}/issues",
                json=issue_data,
                headers=self.headers
            )
        
        # Check for errors
        if response.status_code != 201:
            raise HTTPException(
                status_code=response.status_code,
                detail=f"Failed to create GitLab issue: {response.text}"
            )
        
        return response.json()
