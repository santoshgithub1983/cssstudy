from app.services.rag_service import RAGService
from app.services.gitlab_service import GitLabService

class AIService:
    def __init__(self):
        self.rag_service = RAGService()
        self.gitlab_service = GitLabService()

    async def process_prompt(self, prompt: str, screenshot: UploadFile, logs: UploadFile):
        if "create issue" in prompt.lower():
            return await self.gitlab_service.create_issue(prompt, screenshot, logs)
        else:
            return await self.rag_service.query(prompt)
