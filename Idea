#### 2. Configuration (app/core/config.py)
```python
from pydantic_settings import BaseSettings

class Settings(BaseSettings):
    openai_api_key: str
    gitlab_token: str
    gitlab_url: str = "https://gitlab.com/api/v4"
    rag_chunk_size: int = 1000
    
    class Config:
        env_file = ".env"

settings = Settings()
```

### 3. Main API Endpoint (app/routers/prompts.py)
```python
from fastapi import APIRouter, UploadFile, File
from app.models.schemas import PromptRequest
from app.services import ai_service, gitlab_service

router = APIRouter()

@router.post("/process-prompt")
async def process_prompt(
    request: PromptRequest,
    screenshot: UploadFile = File(None),
    logs: UploadFile = File(None)
):
    if ai_service.is_issue_creation(request.prompt):
        return await gitlab_service.create_issue(
            request.username,
            request.prompt,
            screenshot,
            logs
        )
    
    return await ai_service.process_with_rag(request.prompt)
```

### 4. AI Service (app/services/ai_service.py)
```python
from langchain_community.vectorstores import Chroma
from langchain_openai import OpenAIEmbeddings, ChatOpenAI
from langchain_text_splitters import CharacterTextSplitter
from app.core.config import settings

class AIService:
    def __init__(self):
        self.embeddings = OpenAIEmbeddings(api_key=settings.openai_api_key)
        self.vector_store = self._initialize_rag()
        self.llm = ChatOpenAI(model="gpt-4-turbo")

    def _initialize_rag(self):
        # Load and process documents
        documents = self._load_documents()
        text_splitter = CharacterTextSplitter(chunk_size=settings.rag_chunk_size)
        texts = text_splitter.split_documents(documents)
        return Chroma.from_documents(texts, self.embeddings)
    
    async def process_with_rag(self, prompt: str):
        relevant_docs = self.vector_store.similarity_search(prompt, k=3)
        context = "\n".join([doc.page_content for doc in relevant_docs])
        
        response = self.llm.invoke(
            f"Context: {context}\n\nQuestion: {prompt}"
        )
        return {"response": response.content}

    @staticmethod
    def is_issue_creation(prompt: str) -> bool:
        return "create issue" in prompt.lower()
```

### 5. GitLab Service (app/services/gitlab_service.py)
```python
import httpx
from app.core.config import settings

class GitLabService:
    def __init__(self):
        self.base_url = settings.gitlab_url
        self.headers = {"PRIVATE-TOKEN": settings.gitlab_token}

    async def upload_file(self, file: UploadFile):
        async with httpx.AsyncClient() as client:
            response = await client.post(
                f"{self.base_url}/uploads",
                files={"file": (file.filename, await file.read())},
                headers=self.headers
            )
        return response.json()["markdown"]

    async def create_issue(self, username: str, description: str, 
                          screenshot: UploadFile, logs: UploadFile):
        attachments = []
        
        for file in [screenshot, logs]:
            if file:
                markdown = await self.upload_file(file)
                attachments.append(markdown)
        
        issue_data = {
            "title": f"Issue from {username}",
            "description": f"{description}\n\nAttachments:\n" + "\n".join(attachments)
        }
        
        async with httpx.AsyncClient() as client:
            response = await client.post(
                f"{self.base_url}/projects/{project_id}/issues",
                json=issue_data,
                headers=self.headers
            )
        
        return response.json()
```

