3. Code Implementation

Step 1: Define the AI Service Interface

Create an abstract base class (ai_service.py) to define the contract for AI services.

python
Copy
# app/services/ai_service.py
from abc import ABC, abstractmethod

class AIService(ABC):
    @abstractmethod
    def generate_response(self, input: str) -> str:
        pass
Step 2: Implement the OpenAI Service

Create a concrete implementation for OpenAI (openai_service.py).

python
Copy
# app/services/openai_service.py
from langchain_openai import AzureChatOpenAI
from app.services.ai_service import AIService

class OpenAIService(AIService):
    def __init__(self, api_key: str, endpoint: str, deployment_name: str, api_version: str):
        self.llm = AzureChatOpenAI(
            deployment_name=deployment_name,
            openai_api_key=api_key,
            azure_endpoint=endpoint,
            openai_api_version=api_version,
        )

    def generate_response(self, input: str) -> str:
        response = self.llm.invoke(input)
        return response.content
Step 3: Implement Another AI Service

Create a concrete implementation for another AI service (other_ai_service.py).

python
Copy
# app/services/other_ai_service.py
from app.services.ai_service import AIService

class OtherAIService(AIService):
    def __init__(self, api_key: str, endpoint: str):
        self.api_key = api_key
        self.endpoint = endpoint

    def generate_response(self, input: str) -> str:
        # Call the other AI service API
        return "Response from another AI service"
Step 4: Dependency Injection

Inject the AI service into your FastAPI app. Use environment variables to decide which service to use.

python
Copy
# app/main.py
from fastapi import FastAPI
from app.services.openai_service import OpenAIService
from app.services.other_ai_service import OtherAIService
from app.routes.upload import router as upload_router
from app.routes.generate import router as generate_router
import os

app = FastAPI()

# Dependency injection for AI service
def get_ai_service():
    ai_provider = os.getenv("AI_PROVIDER", "openai")  # Default to OpenAI
    if ai_provider == "openai":
        return OpenAIService(
            api_key=os.getenv("AZURE_OPENAI_API_KEY"),
            endpoint=os.getenv("AZURE_OPENAI_ENDPOINT"),
            deployment_name=os.getenv("AZURE_OPENAI_DEPLOYMENT_NAME"),
            api_version=os.getenv("AZURE_OPENAI_API_VERSION"),
        )
    elif ai_provider == "other":
        return OtherAIService(
            api_key=os.getenv("OTHER_AI_API_KEY"),
            endpoint=os.getenv("OTHER_AI_ENDPOINT"),
        )
    else:
        raise ValueError(f"Unsupported AI provider: {ai_provider}")

# Include routers
app.include_router(upload_router)
app.include_router(generate_router)

# Inject AI service into the app state
@app.on_event("startup")
async def startup_event():
    app.state.ai_service = get_ai_service()
Step 5: Define Routes

Separate routes into their own modules.

Upload Route

python
Copy
# app/routes/upload.py
from fastapi import APIRouter, File, UploadFile, HTTPException
from app.utils.file_utils import save_uploaded_file
from app.services.ai_service import AIService

router = APIRouter()

@router.post("/upload")
async def upload_document(file: UploadFile = File(...)):
    try:
        file_path = save_uploaded_file(file)
        # Process the file (e.g., load into vector store)
        return {"message": "File uploaded successfully!"}
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))
Generate Route

python
Copy
# app/routes/generate.py
from fastapi import APIRouter, Depends, HTTPException
from app.models.request import RequestBody
from app.services.ai_service import AIService

router = APIRouter()

@router.post("/generate")
async def generate_response(data: RequestBody, ai_service: AIService = Depends(get_ai_service)):
    try:
        response = ai_service.generate_response(data.input)
        return {"response": response}
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))
Step 6: Utility Functions

Move file handling logic to a utility module.

python
Copy
# app/utils/file_utils.py
import os

def save_uploaded_file(file: UploadFile) -> str:
    file_path = f"temp_{file.filename}"
    with open(file_path, "wb") as f:
        f.write(file.file.read())
    return file_path
