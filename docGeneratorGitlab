import os
from auto_doc_gen.gitlab_client import fetch_repo_files
from auto_doc_gen.code_parser import extract_functions
from auto_doc_gen.llm_summarizer import summarize_function
from auto_doc_gen.doc_generator import generate_markdown
import requests

def run(project_id, token):
    files = fetch_repo_files(project_id, token)
    summaries = {}
    for f in files[:3]:  # limit for MVP
        url = f"https://gitlab.com/api/v4/projects/{project_id}/repository/files/{f['path']}?ref=main"
        res = requests.get(url, headers={"PRIVATE-TOKEN": token})
        content = res.json().get('content')
        if content:
            import base64
            decoded = base64.b64decode(content).decode()
            funcs = extract_functions(decoded)
            for func in funcs:
                summaries[func] = summarize_function(func)
    markdown = generate_markdown(summaries)
    with open("FUNCTIONAL_DOC.md", "w") as f:
        f.write(markdown)

# Example usage:
# run(project_id='12345678', token='your_gitlab_token')
