import requests

def fetch_repo_files(project_id, token):
    url = f"https://gitlab.com/api/v4/projects/{project_id}/repository/tree?recursive=true"
    headers = {"PRIVATE-TOKEN": token}
    res = requests.get(url, headers=headers)
    return [f for f in res.json() if f['type'] == 'blob' and f['path'].endswith('.py')]
