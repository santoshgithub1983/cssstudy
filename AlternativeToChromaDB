You're welcome! If you're facing issues with ChromaDB, there are several alternative vector databases you can use for RAG (Retrieval-Augmented Generation). Below, I'll guide you on how to replace ChromaDB with FAISS (Facebook AI Similarity Search), which is lightweight and easy to set up.

Step 1: Replace ChromaDB with FAISS
Install FAISS:

bash
Copy
pip install faiss-cpu
Update app/utils/rag.py to use FAISS:

python
Copy
import faiss
import numpy as np
from sentence_transformers import SentenceTransformer
from dotenv import load_dotenv
import os

load_dotenv()

# Initialize FAISS index and SentenceTransformer model
model = SentenceTransformer('all-MiniLM-L6-v2')  # Lightweight embedding model
dimension = 384  # Dimension of the embeddings
index = faiss.IndexFlatL2(dimension)  # L2 distance index

# Store documents and their embeddings
documents = []
document_embeddings = []

def add_documents(new_documents: list):
    """Add documents to the FAISS index."""
    global documents, document_embeddings
    documents.extend(new_documents)
    embeddings = model.encode(new_documents)
    if document_embeddings:
        document_embeddings = np.vstack((document_embeddings, embeddings))
    else:
        document_embeddings = embeddings
    index.add(np.array(embeddings))

def search_documents(query: str, top_k: int = 3):
    """Search documents using FAISS."""
    query_embedding = model.encode([query])
    distances, indices = index.search(query_embedding, top_k)
    return [documents[i] for i in indices[0]]
