Alternative Vector Databases
If FAISS doesn't meet your needs, here are other alternatives:

1. Pinecone
A managed vector database with a free tier.

Install the SDK:

bash
Copy
pip install pinecone-client
Update app/utils/rag.py to use Pinecone:

python
Copy
import pinecone
from sentence_transformers import SentenceTransformer
from dotenv import load_dotenv
import os

load_dotenv()

# Initialize Pinecone
pinecone.init(api_key=os.getenv("PINECONE_API_KEY"), environment="us-west1-gcp")
index = pinecone.Index("rag-index")

# Initialize SentenceTransformer model
model = SentenceTransformer('all-MiniLM-L6-v2')

def add_documents(new_documents: list):
    """Add documents to the Pinecone index."""
    embeddings = model.encode(new_documents)
    vectors = [(str(i), embedding) for i, embedding in enumerate(embeddings)]
    index.upsert(vectors=vectors, namespace="documents")

def search_documents(query: str, top_k: int = 3):
    """Search documents using Pinecone."""
    query_embedding = model.encode([query])
    results = index.query(query_embedding, top_k=top_k, namespace="documents")
    return [documents[int(match.id)] for match in results.matches]
2. Weaviate
An open-source vector database with a managed cloud option.

Install the SDK:

bash
Copy
pip install weaviate-client
Update app/utils/rag.py to use Weaviate:

python
Copy
import weaviate
from sentence_transformers import SentenceTransformer
from dotenv import load_dotenv
import os

load_dotenv()

# Initialize Weaviate client
client = weaviate.Client(url=os.getenv("WEAVIATE_URL"))

# Initialize SentenceTransformer model
model = SentenceTransformer('all-MiniLM-L6-v2')

def add_documents(new_documents: list):
    """Add documents to the Weaviate index."""
    for doc in new_documents:
        embedding = model.encode(doc)
        client.data_object.create(
            data_object={"content": doc},
            class_name="Document",
            vector=embedding
        )

def search_documents(query: str, top_k: int = 3):
    """Search documents using Weaviate."""
    query_embedding = model.encode(query)
    results = client.query.get("Document", ["content"]).with_near_vector({
        "vector": query_embedding,
        "certainty": 0.7
    }).with_limit(top_k).do()
    return [result["content"] for result in results["data"]["Get"]["Document"]]
