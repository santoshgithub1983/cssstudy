from typing import Dict, Any, Callable
import inspect

class MCPBase:
    def __init__(self):
        self.tools: Dict[str, Dict] = {}
    
    def tool(self, name: str = None, description: str = ""):
        def decorator(func: Callable):
            tool_name = name or func.__name__
            self.tools[tool_name] = {
                "function": func,
                "description": description,
                "signature": self._get_signature(func)
            }
            return func
        return decorator
    
    def _get_signature(self, func: Callable) -> Dict[str, str]:
        sig = inspect.signature(func)
        return {
            param: str(param_type)
            for param, param_type in sig.parameters.items()
        }
