import os
import ast
import re

def extract_python_functions(filepath):
    try:
        with open(filepath, "r", encoding="utf-8") as file:
            code = file.read()
        node = ast.parse(code)
        functions = []
        for n in ast.walk(node):
            if isinstance(n, ast.FunctionDef):
                func_code = ast.get_source_segment(code, n)
                functions.append({
                    "name": n.name,
                    "code": func_code,
                    "filepath": filepath
                })
        return functions
    except Exception as e:
        print(f"Error parsing {filepath}: {e}")
        return []

def extract_java_js_functions(filepath):
    try:
        with open(filepath, "r", encoding="utf-8") as file:
            code = file.read()

        pattern = r"(public|private|protected)?\\s*(static)?\\s*\\w+\\s+(\\w+)\\s*\\([^)]*\\)\\s*\\{"
        matches = re.finditer(pattern, code)
        functions = []
        for match in matches:
            func_name = match.group(3)
            snippet = code[match.start():match.start() + 1000]  # crude slicing
            functions.append({
                "name": func_name,
                "code": snippet,
                "filepath": filepath
            })
        return functions
    except Exception as e:
        print(f"Error parsing {filepath}: {e}")
        return []

def filter_code_by_keyword(repo_path, keyword):
    result = []
    for root, _, files in os.walk(repo_path):
        for file in files:
            path = os.path.join(root, file)
            if file.endswith(".py"):
                funcs = extract_python_functions(path)
            elif file.endswith(".java") or file.endswith(".js"):
                funcs = extract_java_js_functions(path)
            else:
                continue

            for func in funcs:
                if keyword.lower() in func["code"].lower() or keyword.lower() in func["name"].lower():
                    result.append(func)
    return result


