import os

def generate_markdown_doc(keyword, summaries, output_path):
    os.makedirs(os.path.dirname(output_path), exist_ok=True)
    with open(output_path, "w", encoding="utf-8") as f:
        f.write(f"# 🔍 Functionality: \"{keyword}\"\n\n")
        for s in summaries:
            f.write(f"## 📁 File: `{s['filepath']}`\n")
            f.write(f"### 🔧 Function: `{s['name']}`\n")
            f.write(f"**Summary:**\n{s['summary']}\n\n")
            f.write("```\n")
            f.write(s["code"] + "\n")
            f.write("```\n\n")


