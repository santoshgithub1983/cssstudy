import openai
import os
from dotenv import load_dotenv

load_dotenv()
openai.api_key = os.getenv("OPENAI_API_KEY")

def summarize_functions(functions):
    results = []
    for func in functions:
        prompt = f"Explain what this function does, including its inputs, outputs, and any side effects:\n\n{func['code']}"
        try:
            response = openai.ChatCompletion.create(
                model="gpt-3.5-turbo",
                messages=[{"role": "user", "content": prompt}]
            )
            summary = response.choices[0].message["content"]
        except Exception as e:
            print(f"❌ Error summarizing function {func['name']}: {e}")
            summary = "LLM Error: Could not summarize."

        results.append({
            "name": func["name"],
            "filepath": func["filepath"],
            "code": func["code"],
            "summary": summary
        })
    return results


