from fastapi import APIRouter, UploadFile, File, HTTPException
from app.services.openai import OpenAIService
from app.services.gitlab import GitLabService
from app.schemas.chat import ChatRequest, IssueRequest
from app.config import settings

router = APIRouter()

def contains_incident_keywords(prompt: str) -> bool:
    return any(keyword in prompt.lower() for keyword in settings.incident_keywords)

@router.post("/chat")
async def handle_chat(request: ChatRequest):
    openai_service = OpenAIService()
    
    try:
        if contains_incident_keywords(request.prompt):
            return {
                "response": "Would you like to create an incident ticket?",
                "requires_confirmation": True
            }
        
        response = openai_service.get_response(request.prompt)
        return {"response": response, "requires_confirmation": False}
    
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

@router.post("/create-issue")
async def create_issue(
    issue_data: IssueRequest,
    files: list[UploadFile] = File(None)
):
    gitlab_service = GitLabService()
    attachments = []
    
    try:
        if files:
            for file in files:
                uploaded_file = gitlab_service.upload_file(file.file)
                attachments.append(uploaded_file)
        
        issue = gitlab_service.create_issue(
            title=f"Incident Report - {issue_data.username}",
            description=f"""
            **User:** {issue_data.username}
            **Email:** {issue_data.email}
            **GPN:** {issue_data.gpn}
            **Description:** {issue_data.description}
            """,
            attachments=attachments
        )
        
        return {"issue_url": issue["web_url"]}
    
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))
