from langchain.llms import OpenAI as LangchainOpenAI
from langchain.embeddings import OpenAIEmbeddings
from langchain.document_loaders import DirectoryLoader
from langchain.vectorstores import FAISS
from langchain.chains import RetrievalQA
import openai
import os

# Set OpenAI API key and base URL
openai.api_key = os.getenv("OPENAI_API_KEY")
openai.api_base = os.getenv("OPENAI_API_BASE", "https://api.openai.com/v1")  # Default to OpenAI if not set

# Custom OpenAI class to accept api_base
class CustomOpenAI(LangchainOpenAI):
    def __init__(self, openai_api_key, openai_api_base, **kwargs):
        super().__init__(openai_api_key=openai_api_key, **kwargs)
        self.openai_api_base = openai_api_base

    def _call(self, prompt, stop=None):
        import openai
        openai.api_key = self.openai_api_key
        openai.api_base = self.openai_api_base
        response = openai.Completion.create(
            engine=self.model_name,
            prompt=prompt,
            max_tokens=self.max_tokens,
            stop=stop
        )
        return response.choices[0].text.strip()

# Load documents
def load_documents():
    loader = DirectoryLoader("documents", glob="**/*.pdf")
    documents = loader.load()
    return documents

# Initialize RAG
def initialize_rag():
    documents = load_documents()
    embeddings = OpenAIEmbeddings(openai_api_key=openai.api_key)
    vectorstore = FAISS.from_documents(documents, embeddings)
    qa_chain = RetrievalQA.from_chain_type(
        llm=CustomOpenAI(openai_api_key=openai.api_key, openai_api_base=openai.api_base, model_name="text-davinci-003"),
        chain_type="stuff",
        retriever=vectorstore.as_retriever()
    )
    return qa_chain

# Process prompt with RAG
def process_prompt_with_rag(prompt: str):
    qa_chain = initialize_rag()
    response = qa_chain.run(prompt)
    return response
