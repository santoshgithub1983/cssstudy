# src/app/config/settings.py
from pydantic_settings import BaseSettings, SettingsConfigDict
from pydantic import field_validator, ValidationError
from typing import Optional

class Settings(BaseSettings):
    # Mark fields as Optional for .env fallback
    azure_openai_endpoint: Optional[str] = None
    azure_openai_key: Optional[str] = None
    gitlab_private_token: Optional[str] = None
    gitlab_project_id: Optional[str] = None

    model_config = SettingsConfigDict(
        env_file=".env",
        env_file_encoding="utf-8",
        extra="ignore"
    )

    @field_validator('*', mode='before')
    @classmethod
    def handle_empty_values(cls, value: str) -> Optional[str]:
        """Convert empty strings to None to trigger environment lookup"""
        return value if value.strip() != "" else None

    def __init__(self, **kwargs):
        super().__init__(**kwargs)
        self._validate_required()

    def _validate_required(self):
        """Ensure required values are present from either source"""
        required_fields = {
            'azure_openai_endpoint': os.getenv('AZURE_OPENAI_ENDPOINT'),
            'azure_openai_key': os.getenv('AZURE_OPENAI_KEY'),
            'gitlab_private_token': os.getenv('GITLAB_PRIVATE_TOKEN'),
            'gitlab_project_id': os.getenv('GITLAB_PROJECT_ID')
        }

        for field, env_value in required_fields.items():
            if getattr(self, field) is None and env_value is None:
                raise ValueError(
                    f"Missing required configuration for {field}. "
                    "Set in .env or environment variables."
                )

settings = Settings()
