from pydantic_settings import BaseSettings, SettingsConfigDict
from pydantic import Field, field_validator
from typing import List, Optional
import os

class Settings(BaseSettings):
    # Azure OpenAI Configuration
    azure_openai_endpoint: str = Field(
        ..., 
        validation_alias="AZURE_OPENAI_ENDPOINT",
        description="Azure OpenAI endpoint URL (required)"
    )
    azure_openai_key: str = Field(
        ..., 
        validation_alias="AZURE_OPENAI_KEY",
        description="Azure OpenAI API key (required)"
    )
    
    # GitLab Configuration
    gitlab_project_id: str = Field(
        ..., 
        validation_alias="GITLAB_PROJECT_ID",
        description="GitLab project ID (required)"
    )
    gitlab_private_token: str = Field(
        ..., 
        validation_alias="GITLAB_PRIVATE_TOKEN",
        description="GitLab access token (required)"
    )
    
    # Incident Detection
    incident_keywords: List[str] = Field(
        default=["incident", "issue", "ticket", "problem"],
        validation_alias="INCIDENT_KEYWORDS",
        description="Comma-separated list of trigger keywords"
    )

    @field_validator('*', mode='before')
    @classmethod
    def handle_empty_values(cls, value):
        """Convert empty strings to None to trigger environment lookup"""
        if isinstance(value, str) and value.strip() == '':
            return None
        return value

    @field_validator('incident_keywords', mode='before')
    @classmethod
    def split_keywords(cls, value):
        """Process comma-separated keywords"""
        if isinstance(value, str):
            return [kw.strip().lower() for kw in value.split(",") if kw.strip()]
        return value

    model_config = SettingsConfigDict(
        # Always check environment variables first
        env_file=".env" if os.path.exists(".env") else None,
        env_file_encoding='utf-8',
        case_sensitive=False,
        extra='ignore'
    )

settings = Settings()
