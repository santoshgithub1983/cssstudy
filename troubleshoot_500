✅ Comprehensive Solution
python
from fastapi import FastAPI, Request
from fastapi.responses import JSONResponse

app = FastAPI()

# Global Error Handler
@app.exception_handler(Exception)
async def universal_exception_handler(request: Request, exc: Exception):
    return JSONResponse(
        status_code=500,
        content={
            "detail": f"Server error: {str(exc)}",
            "type": exc.__class__.__name__
        }
    )

# Enhanced Workflow Setup
class WorkflowState(BaseModel):
    line_items: list
    date: str
    processed_data: dict = {}  # Ensure all possible fields

# Add node with error handling
def safe_processing_node(state: WorkflowState):
    try:
        # Your node logic here
        return {"processed_data": {...}}
    except Exception as e:
        raise ValueError(f"Node failed: {str(e)}")
