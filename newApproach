from .base_storage import BaseStorage
from typing import List

class SharePointStorage(BaseStorage):
    def __init__(self, site_url: str, client_id: str, client_secret: str):
        self.client = SharePointClient(site_url, client_id, client_secret)

    def load_documents(self) -> List[str]:
        documents = []
        for file in self.client.list_files("/path/to/documents"):
            documents.append(file.content)
        return documents
