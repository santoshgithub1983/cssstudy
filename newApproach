import openai
from app.utils.environment import OPENAI_API_KEY, OPENAI_API_BASE

openai.api_key = OPENAI_API_KEY

# Set the base URL for the OpenAI API if a custom endpoint is specified
if OPENAI_API_BASE:
    openai.api_base = OPENAI_API_BASE

def process_prompt(prompt: str):
    response = openai.Completion.create(
        engine="text-davinci-003",
        prompt=prompt,
        max_tokens=150
    )
    return response.choices[0].text.strip()
GitLab Client: gitlab_client.py
Copy
import gitlab
from app.utils.environment import GITLAB_TOKEN, GITLAB_URL

gl = gitlab.Gitlab(GITLAB_URL, private_token=GITLAB_TOKEN)

def create_issue(project_id: int, username: str, description: str, screenshot: bytes = None, network_logs: str = None):
    issue = gl.projects.get(project_id).issues.create({
        'title': f'Issue created by {username}',
        'description': description
    })

    if screenshot:
        upload = gl.uploads.create({'file': ('screenshot.png', screenshot)})
        issue.notes.create({'body': f"Screenshot: ![screenshot]({upload['url']})"})

    if network_logs:
        issue.description = f"{issue.description}\n\n**Network Logs:**\n{network_logs}"
        issue.save()

    return issue
Document Search: document_search.py
Copy
from langchain.chains import RetrievalQA
from langchain.embeddings import OpenAIEmbeddings
from langchain.vectorstores import FAISS
from langchain.text_splitter import CharacterTextSplitter
from langchain.llms import OpenAI
from .storage.base_storage import BaseStorage

def setup_document_search(storage: BaseStorage):
    documents = storage.load_documents()
    text_splitter = CharacterTextSplitter(chunk_size=1000, chunk_overlap=0)
    texts = text_splitter.split_documents(documents)
    embeddings = OpenAIEmbeddings()
    vector_store = FAISS.from_documents(texts, embeddings)
    qa_chain = RetrievalQA.from_chain_type(
        llm=OpenAI(),
        chain_type="stuff",
        retriever=vector_store.as_retriever(),
        return_source_documents=True
    )
    return qa_chain

def search_documents(qa_chain, query: str):
    result = qa_chain({"query": query})
    return result['result']
