from fastapi import APIRouter
from app.services.openai import OpenAIService
from app.services.incident_detector import contains_incident_keywords
from app.config import settings

router = APIRouter()

@router.post("/chat")
async def handle_chat(prompt: str):
    if contains_incident_keywords(prompt):
        return {
            "action": "create_incident",
            "message": "Would you like to create a support ticket?"
        }
    
    # Normal processing
    response = OpenAIService().get_response(prompt)
    return {"response": response}
