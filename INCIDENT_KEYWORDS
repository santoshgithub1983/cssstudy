from pydantic_settings import BaseSettings, SettingsConfigDict
from pydantic import Field, field_validator, ValidationInfo
from typing import List
import os

class Settings(BaseSettings):
    # Azure OpenAI Configuration
    azure_openai_endpoint: str = Field(
        ..., 
        validation_alias="AZURE_OPENAI_ENDPOINT",
        description="Azure OpenAI endpoint URL"
    )
    azure_openai_key: str = Field(
        ..., 
        validation_alias="AZURE_OPENAI_KEY",
        description="Azure OpenAI API key"
    )
    
    # GitLab Configuration
    gitlab_project_id: str = Field(
        ..., 
        validation_alias="GITLAB_PROJECT_ID",
        description="GitLab project ID"
    )
    gitlab_private_token: str = Field(
        ..., 
        validation_alias="GITLAB_PRIVATE_TOKEN",
        description="GitLab access token"
    )
    
    # Incident Detection Configuration
    incident_keywords: List[str] = Field(
        default=["incident", "issue", "ticket", "problem"],
        validation_alias="INCIDENT_KEYWORDS",
        description="Comma-separated list of trigger keywords"
    )

    @field_validator('incident_keywords', mode='before')
    @classmethod
    def process_incident_keywords(cls, value: str | None, info: ValidationInfo) -> List[str]:
        """Parse and validate incident keywords from comma-separated string"""
        field = info.field
        default = field.default
        
        # Get raw value from environment if not passed directly
        if value is None:
            env_value = os.getenv(field.validation_alias or "INCIDENT_KEYWORDS")
            value = env_value if env_value is not None else value

        # Handle empty/None cases
        if not value:
            return default

        # Process string input
        if isinstance(value, str):
            keywords = [kw.strip().lower() for kw in value.split(",") if kw.strip()]
            return keywords if keywords else default

        # Handle list input (from .env file if using JSON)
        if isinstance(value, list):
            return [kw.strip().lower() for kw in value if kw.strip()]

        return default

    model_config = SettingsConfigDict(
        env_file=".env" if os.path.exists(".env") else None,
        env_file_encoding='utf-8',
        case_sensitive=False,
        extra='ignore'
    )

settings = Settings()
