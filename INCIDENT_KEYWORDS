from app.config import settings

def contains_incident_keywords(prompt: str) -> bool:
    """Check if prompt contains any incident keywords"""
    prompt_lower = prompt.lower()
    return any(
        keyword in prompt_lower
        for keyword in settings.incident_keywords
    )
