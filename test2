Copy
import org.apache.http.client.methods.HttpPost;
import org.apache.http.entity.StringEntity;
import org.apache.http.impl.client.CloseableHttpClient;
import org.apache.http.impl.client.HttpClients;
import org.apache.http.util.EntityUtils;
import org.json.JSONObject;

public class GitLabService {

    public static String submitIssue(String gitlabToken, String projectId, String title, String description) throws Exception {
        String url = "https://gitlab.com/api/v4/projects/" + projectId + "/issues";

        JSONObject issue = new JSONObject();
        issue.put("title", title);
        issue.put("description", description);

        try (CloseableHttpClient client = HttpClients.createDefault()) {
            HttpPost httpPost = new HttpPost(url);
            httpPost.setHeader("Authorization", "Bearer " + gitlabToken);
            httpPost.setHeader("Content-Type", "application/json");
            httpPost.setEntity(new StringEntity(issue.toString()));

            String response = EntityUtils.toString(client.execute(httpPost).getEntity());
            JSONObject responseJson = new JSONObject(response);
            return responseJson.getString("web_url");
        }
    }
}
