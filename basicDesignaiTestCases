        response = test_client.post(
            "/api/v1/create-issue",
            data={
                "username": "john",
                "email": "john@example.com",
                "gpn": "12345",
                "description": "Network issue",
                "session_id": "test123"
            },
            files={"files": ("malicious.exe", invalid_file, "application/exe")}
        )
    
    assert response.status_code == status.HTTP_500_INTERNAL_SERVER_ERROR
    assert "Unsupported file type" in response.json()["detail"]

def test_file_size_validation(test_client, mocker):
    mocker.patch("app.services.gitlab.GitLabService.upload_file",
                side_effect=ValueError("File size exceeds 10MB limit"))
    
    # Simulate large file upload
    with tempfile.NamedTemporaryFile(suffix=".log") as large_file:
        large_file.write(b"0" * 11 * 1024 * 1024)  # 11MB
        large_file.seek(0)
        
        response = test_client.post(
            "/api/v1/create-issue",
            data={
                "username": "john",
                "email": "john@example.com",
                "gpn": "12345",
                "description": "Large log file",
                "session_id": "test123"
            },
            files={"files": ("huge.log", large_file, "text/plain")}
        )
    
    assert response.status_code == status.HTTP_500_INTERNAL_SERVER_ERROR
    assert "File size exceeds" in response.json()["detail"]
