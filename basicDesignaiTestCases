import pytest
from unittest.mock import Mock
from app.services.gitlab import GitLabService

def test_file_upload_success(mocker):
    mock_response = Mock()
    mock_response.json.return_value = {"markdown": "[file.txt](/uploads/123/file.txt)"}
    mock_response.raise_for_status.return_value = None
    
    mocker.patch("requests.post", return_value=mock_response)
    
    service = GitLabService()
    result = service.upload_file(Mock(
        filename="test.txt",
        file=Mock(),
        content_type="text/plain"
    ))
    
    assert "file.txt" in result

def test_create_issue_with_attachments(mocker):
    mock_response = Mock()
    mock_response.json.return_value = {"web_url": "https://gitlab.com/issue/123"}
    mock_response.raise_for_status.return_value = None
    mocker.patch("requests.post", return_value=mock_response)
    
    service = GitLabService()
    result = service.create_issue(
        title="Test Issue",
        description="Test Description",
        attachments=["[file.txt](/uploads/123/file.txt)"]
    )
    
    assert "gitlab.com" in result["web_url"]
