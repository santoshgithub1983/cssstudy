from app.services.openai import OpenAIService

def test_openai_service_response(mocker):
    mock_client = mocker.patch("openai.resources.chat.Completions.create")
    mock_client.return_value = {
        "choices": [{"message": {"content": "Test response"}}]
    }
    
    service = OpenAIService()
    response = service.get_response("Test prompt")
    
    assert response == "Test response"

def test_openai_service_error_handling(mocker):
    mocker.patch(
        "openai.resources.chat.Completions.create",
        side_effect=Exception("API Error")
    )
    
    service = OpenAIService()
    with pytest.raises(RuntimeError) as exc_info:
        service.get_response("Test prompt")
    
    assert "API Error" in str(exc_info.value)
