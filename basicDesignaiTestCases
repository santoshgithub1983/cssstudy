from fastapi import status

def test_chat_endpoint_normal_response(test_client, mocker):
    # Mock OpenAI response
    mock_openai = mocker.patch("app.services.openai.OpenAIService.get_response")
    mock_openai.return_value = "Reset your password using the portal"
    
    response = test_client.post("/api/v1/chat", json={
        "prompt": "How to reset password?",
        "session_id": "test123"
    })
    
    assert response.status_code == status.HTTP_200_OK
    assert not response.json()["requires_confirmation"]
    assert "reset" in response.json()["response"].lower()

def test_chat_endpoint_incident_trigger(test_client):
    response = test_client.post("/api/v1/chat", json={
        "prompt": "We have a critical incident",
        "session_id": "test456"
    })
    
    assert response.status_code == status.HTTP_200_OK
    assert response.json()["requires_confirmation"]
    assert "create an incident ticket" in response.json()["response"]
