import tempfile
from fastapi import status

def test_create_issue_with_files(test_client, mocker):
    # Mock GitLab API responses
    mock_upload = mocker.patch("app.services.gitlab.GitLabService.upload_file")
    mock_upload.return_value = "[network.log](/uploads/123/network.log)"
    
    mock_create = mocker.patch("app.services.gitlab.GitLabService.create_issue")
    mock_create.return_value = {
        "id": 123,
        "web_url": "https://gitlab.com/test-project/-/issues/123"
    }

    with tempfile.NamedTemporaryFile(suffix=".log") as test_file:
        test_file.write(b"test log content")
        test_file.seek(0)
        
        response = test_client.post(
            "/api/v1/create-issue",
            data={
                "username": "john",
                "email": "john@example.com",
                "gpn": "12345",
                "description": "Network outage",
                "session_id": "test123"
            },
            files={"files": ("network.log", test_file, "text/plain")}
        )

    assert response.status_code == status.HTTP_200_OK
    assert "gitlab.com" in response.json()["web_url"]

def test_create_issue_validation_error(test_client):
    response = test_client.post("/api/v1/create-issue", data={
        "username": "john",
        # Missing required email field
        "gpn": "12345",
        "description": "Network outage",
        "session_id": "test123"
    })
    
    assert response.status_code == status.HTTP_422_UNPROCESSABLE_ENTITY
    assert "email" in response.text
